{
    "compilerOptions": {
        "resolveJsonModule": true,
        "target": "ESNext",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "strict": true,
        "allowJs": true,
        "strictNullChecks": false,
        "esModuleInterop": true,
        "experimentalDecorators": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "useDefineForClassFields": false,
        "paths": {
            "#data/*": [
                "./src/data/*"
            ],
            "#rooms/*": [
                "./src/rooms/*"
            ],
            "#services/*": [
                "./src/services/*"
            ],
            "#game/*": [
                "./src/game/*"
            ]
        }
    },
    "include": [
        "src",
        "test"
    ]
}
