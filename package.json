{
    "private": true,
    "name": "my-app",
    "version": "0.17.0",
    "description": "npm init template for bootstrapping an empty Colyseus project",
    "type": "module",
    "main": "build/index.js",
    "engines": {
        "node": ">= 20.9.0"
    },
    "imports": {
        "#rooms/*": "./build/rooms/*",
        "#services/*": "./build/services/*",
        "#data/*": "./build/data/*",
        "#game/*": "./build/game/*"
    },
    "scripts": {
        "extract:answers": "tsx src/scripts/extractCountriesAnswerValidation.ts",
        "extract:continents": "tsx src/scripts/extractContinents.ts",
        "extract:public-map": "tsx src/scripts/extractPublicCountryMapFeatures.ts",
        "generate:country-scores": "tsx src/scripts/generateCountryScores.ts",
        "lint": "eslint src",
        "lint:fix": "eslint src --fix",
        "format": "prettier . --write",
        "format:check": "prettier . --check",
        "dev": "tsx watch src/index.ts",
        "start": "node build/index.js",
        "loadtest": "tsx loadtest/example.ts --room my_room --numClients 2",
        "build": "npm run clean && tsc -p tsconfig.build.json",
        "clean": "rimraf build",
        "test": "mocha -r tsx test/**.test.ts --exit --timeout 15000"
    },
    "author": "",
    "license": "UNLICENSED",
    "bugs": {
        "url": "https://github.com/colyseus/create-colyseus/issues"
    },
    "homepage": "https://github.com/colyseus/create-colyseus#readme",
    "devDependencies": {
        "@colyseus/loadtest": "^0.17.7",
        "@colyseus/sdk": "^0.17.17",
        "@colyseus/testing": "^0.17.10",
        "@eslint/js": "^10.0.1",
        "@turf/area": "^7.4.0",
        "@types/express": "^4.17.1",
        "@types/mocha": "^10.0.1",
        "cheerio": "^1.2.0",
        "eslint": "^10.4.0",
        "eslint-config-prettier": "^10.1.8",
        "mocha": "^11.7.6",
        "prettier": "^3.8.3",
        "rimraf": "^5.0.0",
        "tsx": "^4.22.3",
        "typescript": "^5.0.4",
        "typescript-eslint": "^8.59.4"
    },
    "dependencies": {
        "@colyseus/schema": "^4.0.0",
        "@colyseus/tools": "^0.17.0",
        "@types/geojson": "^7946.0.16",
        "colyseus": "^0.17.6",
        "express": "^4.18.2"
    }
}
